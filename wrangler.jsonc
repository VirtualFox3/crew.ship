{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "howl-host",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",

  // `nodejs_compat` is required, not optional: the panel signs agent tokens
  // with node:crypto (createHmac / createHash / timingSafeEqual) and Supabase's
  // SSR client expects Node globals.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }
}
