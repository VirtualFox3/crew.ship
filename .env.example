# ---------------------------------------------------------------------------
# Panel (Next.js on Vercel or Cloudflare Pages)
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-side only; never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret between the panel and every node agent.
# Generate with: openssl rand -base64 48
AGENT_SHARED_SECRET=change-me-to-a-long-random-string

# Root domain servers get their address under: <subdomain>.<this>
NEXT_PUBLIC_SERVER_DOMAIN=pack.host

# Public URL of the panel. Vercel sets this automatically; set it explicitly
# for a custom domain so OAuth redirects land in the right place.
# NEXT_PUBLIC_SITE_URL=https://pack.host

# ---------------------------------------------------------------------------
# Cloudflare Workers only
# ---------------------------------------------------------------------------
# `next build` inlines NEXT_PUBLIC_* into the browser bundle, so on Cloudflare
# those three must be present at BUILD time -- put them in .env.production
# (gitignored). `wrangler secret put` runs too late for them.
#
# The two real secrets go the other way, as runtime secrets that never touch a
# bundle:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler secret put AGENT_SHARED_SECRET
#
# Vercel needs none of this split -- dashboard variables are available at both
# build and runtime.
