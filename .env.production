# Public build-time configuration. COMMITTED ON PURPOSE.
#
# Next.js inlines NEXT_PUBLIC_* into the browser bundle at build time, so these
# have to exist when `next build` runs. There is no way to set them from an
# API, so they live here instead of in the Vercel dashboard.
#
# Nothing here is a secret. The anon key is designed to be shipped to browsers;
# row-level security, not this key, is what protects the data. Real environment
# variables take precedence over this file, so setting any of these in the
# Vercel or Cloudflare dashboard overrides what is written here.
#
# NEVER add SUPABASE_SERVICE_ROLE_KEY or AGENT_SHARED_SECRET to this file.
# The service role key bypasses row-level security entirely and the agent
# secret is a signing key — both must be set as dashboard/runtime secrets.

NEXT_PUBLIC_SUPABASE_URL=https://uxjhadjkkufpbanmtnzp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV4amhhZGpra3VmcGJhbm10bnpwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU0NzQ1NjQsImV4cCI6MjEwMTA1MDU2NH0.URAaABS77dCA6lvPj3BXIfHTf12h_cYhO-WWlJDK_9U
NEXT_PUBLIC_SERVER_DOMAIN=pack.host
