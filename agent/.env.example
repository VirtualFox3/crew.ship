# Identity ------------------------------------------------------------------
# UUID of the row you inserted into the panel's `nodes` table.
NODE_ID=00000000-0000-0000-0000-000000000000
NODE_NAME=node-1

# Must match AGENT_SHARED_SECRET in the panel's environment.
AGENT_SHARED_SECRET=change-me-to-a-long-random-string

# Where the panel lives, so the agent can push status back.
PANEL_URL=https://your-panel.vercel.app

# Networking ----------------------------------------------------------------
PORT=8080
# Ports handed out to Minecraft servers. Must match the node row in the panel
# and be open in your firewall (TCP for Java, UDP for Bedrock).
PORT_RANGE_START=25600
PORT_RANGE_END=25999

# Capacity ------------------------------------------------------------------
MAX_SERVERS=40
# Total RAM the agent will hand out, in MB. Leave headroom for the host.
MAX_MEMORY_MB=32768

# Storage -------------------------------------------------------------------
DATA_DIR=/var/lib/packhost

# Docker images -------------------------------------------------------------
JAVA_IMAGE=itzg/minecraft-server:latest
BEDROCK_IMAGE=itzg/minecraft-bedrock-server:latest
